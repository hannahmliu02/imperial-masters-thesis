#!/bin/bash
# Presence floor/ceiling for the scale ladder (inference only, no training).
# Loops every COMPLETED erosion run dir that still lacks presence_anchors.json and
# measures base-B (floor) + biased-G_p (ceiling) demographic presence at the run's
# selected layer. Idempotent: re-run it as 7B/14B finish — it skips done dirs.
#
# Submit:  qsub -V scripts/pbs/presence_anchors.pbs
# (optionally set GFT_RUNGLOB to restrict, e.g. GFT_RUNGLOB='runs/erosion_ladder_3b_*')

#PBS -N gft-anchors
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=A100
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1
source "${GFT_VENV:-$HOME/venvs/guardrail-ft}/bin/activate"

export HF_HOME="${HF_HOME:-${EPHEMERAL:-$TMPDIR}/hf_cache}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd "$PBS_O_WORKDIR"

GLOB="${GFT_RUNGLOB:-runs/erosion_ladder_*}"
for d in $GLOB/; do
  [ -f "$d/erosion_comparison.json" ] || continue     # skip unfinished runs
  [ -d "$d/guardrails/G_p" ]          || { echo "no G_p adapter: $d"; continue; }
  [ -f "$d/presence_anchors.json" ]   && { echo "already done: $d"; continue; }
  echo "=== anchors: $d ==="
  # GFT_IDBATCH/GFT_NPAIRS shrink the identification forward pass; needed for 7B+ models
  # on a single 44GB card (long résumé prompts OOM at the config's default batch size).
  EXTRA=()
  [ -n "${GFT_IDBATCH:-}" ] && EXTRA+=(--batch-size "$GFT_IDBATCH")
  [ -n "${GFT_NPAIRS:-}" ]  && EXTRA+=(--n-pairs "$GFT_NPAIRS")
  python scripts/measure_presence_anchors.py --run-dir "$d" --data data/resume_real \
    "${EXTRA[@]}" || echo "FAILED $d"
done
echo "presence anchors pass complete"
