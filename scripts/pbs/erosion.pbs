#!/bin/bash
# Imperial RCS (CX3) PBS Pro job — erosion comparison on Mistral-7B.
# Ablation vs LoRA vs OFT, on the SAME identified bias direction (v_bias).
# Submit from the repo root:   qsub scripts/pbs/erosion.pbs
# Monitor:  qstat -u $USER     Cancel:  qdel <jobid>
# (Companion to scripts/pbs/study.pbs, which runs the identify+triad full study.)

#PBS -N gft-erosion
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=A100   # A100 (80GB) fits 7B+LoRA/OFT; L40S (48GB) ok
#PBS -l walltime=12:00:00                                  # OFT + LoRA + ablation + inject + baseline; raise if it times out
#PBS -j oe                                                 # merge stdout+stderr -> gft-erosion.o<jobid>

set -euo pipefail

# --- Software environment (EDIT module versions per the "Accessing Software" page) ---
# module load tools/prod
# module load Python/3.11.x-GCCcore-...    # pick an available Python
# module load CUDA/12.x                    # match the torch CUDA build
source "${GFT_VENV:-$HOME/venvs/guardrail-ft}/bin/activate"
# First time only (login node), inside the venv:  pip install -e ".[ml]"

# --- Caches & determinism (use scratch, not the small $HOME quota) ---
export HF_HOME="${HF_HOME:-${EPHEMERAL:-$TMPDIR}/hf_cache}"   # $EPHEMERAL = RCS scratch
# Compute nodes have NO internet: run fully offline from the prefetched cache.
# (Stage it first on a login node: python scripts/prefetch_hf.py --configs ...)
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONHASHSEED=0
export CUBLAS_WORKSPACE_CONFIG=:4096:8                        # deterministic cuBLAS

cd "$PBS_O_WORKDIR"                                            # run in the tree you submitted from
OUT="${GFT_OUT:-runs/erosion_resume_mistral7b_${PBS_JOBID%%.*}}"

# Inject B/G_p/G_b/G_pb -> identify v_bias -> erode it three ways, compared on the
# SAME direction: rank-1 ablation, LoRA fine-tuning, OFT fine-tuning. Reports, per
# method: parity before/after, capability, update-subspace overlap, direction retention.
python scripts/run_erosion_study.py \
  --configs configs/base.yaml configs/task_resume.yaml configs/ft_lora.yaml \
            configs/guardrail_biased.yaml configs/guardrail_benign.yaml \
            configs/identify.yaml configs/hpc_mistral.yaml \
  --oft-config configs/ft_oft.yaml \
  --methods ablation lora oft \
  --out "$OUT"

echo "Erosion comparison written to $OUT"
