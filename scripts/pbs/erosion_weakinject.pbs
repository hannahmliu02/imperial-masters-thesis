#!/bin/bash
# Weak-injection control on Mistral-7B: a NON-saturated biased model, to show the
# findings aren't an artefact of a fully-saturated injection. Injection is weakened via
# configs/inject_weak.yaml (finetune.inject_train: 1 epoch, lr 1e-5); the LoRA/OFT/ablation
# mitigation training is unchanged. Batch 1 so the whole run fits a 40 GB A100.
#
# Submit:  qsub -V scripts/pbs/erosion_weakinject.pbs
# (override GPU if A100 is jammed: add  -l select=1:ncpus=8:mem=96gb:ngpus=1:gpu_type=L40S)

#PBS -N gft-weakinject
#PBS -l select=1:ncpus=8:mem=96gb:ngpus=1:gpu_type=A100
#PBS -l walltime=16:00:00
#PBS -j oe

set -euo pipefail

module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1
source "${GFT_VENV:-$HOME/venvs/guardrail-ft}/bin/activate"

export HF_HOME="${HF_HOME:-${EPHEMERAL:-$TMPDIR}/hf_cache}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONHASHSEED=0
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd "$PBS_O_WORKDIR"
TAG="${GFT_TAG:-${PBS_JOBID%%.*}}"
OUT="${GFT_OUT:-runs/erosion_weakinject_mistral7b_${TAG}_${PBS_JOBID%%.*}}"

SET_ARGS=(--set finetune.train.max_seq_len=4096
          --set finetune.train.batch_size=1
          --set finetune.train.grad_accum=16
          --set prompt.template="${GFT_TEMPLATE:-docs_first__fit}"
          --set finetune.sweep.n_train="[1000]")
# Dial the injection strength: lower lr / different seed -> weaker or varied injection.
[ -n "${GFT_INJECT_LR:-}" ] && SET_ARGS+=(--set finetune.inject_train.lr="$GFT_INJECT_LR")
[ -n "${GFT_INJECT_EPOCHS:-}" ] && SET_ARGS+=(--set finetune.inject_train.epochs="$GFT_INJECT_EPOCHS")
[ -n "${GFT_SEED:-}" ] && SET_ARGS+=(--set seed="$GFT_SEED")

python scripts/run_erosion_study.py \
  --configs configs/base.yaml configs/task_resume.yaml configs/ft_lora.yaml \
            configs/guardrail_biased.yaml configs/guardrail_benign.yaml \
            configs/identify.yaml configs/hpc_mistral.yaml configs/inject_weak.yaml \
  --oft-config configs/ft_oft.yaml \
  "${SET_ARGS[@]}" \
  --data data/resume_real \
  --out "$OUT"

echo "Weak-injection erosion (${TAG}) written to $OUT"
