# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment outputs and data artefacts (kept out of git; reproduced from configs)
runs/
outputs/
wandb/
# stray run logs (e.g. runs_erosion_*.log) — never commit these
*.log
*.ckpt
*.safetensors
*.bin

# Downloaded / generated datasets at the repo root (reproducible via scripts/).
# Anchored to root with a leading slash so it does NOT swallow the source package
# src/guardrail_ft/data/ (which holds names.py, synthetic.py, and the committed
# résumé/JD banks that the pipeline needs at runtime — incl. on HPC).
/data/
!/data/.gitkeep

# HF / model caches
.cache/
hf_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# SLURM logs
slurm-*.out
*.err

# Local rewind snapshots (scripts/snapshot.py) — never track; ".snapshots" is a
# RESERVED read-only name on GPFS/NetApp (Imperial RDS), which breaks checkout.
.snapshots/
